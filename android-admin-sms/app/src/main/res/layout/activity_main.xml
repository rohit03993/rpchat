<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <!-- Full admin website -->
  <WebView
    android:id="@+id/adminWeb"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <!-- Login overlay -->
  <ScrollView
    android:id="@+id/loginPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A1419"
    android:visibility="gone">

    <LinearLayout
      android:orientation="vertical"
      android:padding="20dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <TextView
        android:text="DesiChat Admin"
        android:textColor="#EEF3F5"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <TextView
        android:text="Full admin on phone · SMS unlock · live alerts"
        android:textColor="#8AA0AB"
        android:textSize="13sp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Site URL">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/baseUrl"
          android:inputType="textUri"
          android:text="https://rpdesichat.online"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Admin ID"
        android:layout_marginTop="8dp">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/adminId"
          android:inputType="text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Admin password"
        android:layout_marginTop="8dp">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/adminPass"
          android:inputType="textPassword"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
      </com.google.android.material.textfield.TextInputLayout>

      <Button
        android:id="@+id/loginBtn"
        android:text="Open full admin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

      <TextView
        android:id="@+id/status"
        android:textColor="#C5D5DC"
        android:textSize="13sp"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    </LinearLayout>
  </ScrollView>

  <!-- Thin listening strip over admin web -->
  <LinearLayout
    android:id="@+id/listenBar"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#CC122028"
    android:gravity="center_vertical"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <TextView
      android:id="@+id/listenLabel"
      android:text="SMS + alerts on"
      android:textColor="#1EC9A0"
      android:textSize="12sp"
      android:layout_weight="1"
      android:layout_width="0dp"
      android:layout_height="wrap_content" />

    <Button
      android:id="@+id/logoutBtn"
      android:text="Logout"
      style="@style/Widget.MaterialComponents.Button.TextButton"
      android:textColor="#F0D28A"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />
  </LinearLayout>
</FrameLayout>
