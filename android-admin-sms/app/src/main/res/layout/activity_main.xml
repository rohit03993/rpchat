<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true"
  android:background="#FFFFFF">

  <!-- Admin web + SMS strip stacked (no overlay on tabs) -->
  <LinearLayout
    android:id="@+id/adminShell"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
      android:id="@+id/listenBar"
      android:orientation="horizontal"
      android:paddingStart="12dp"
      android:paddingEnd="4dp"
      android:paddingTop="8dp"
      android:paddingBottom="8dp"
      android:background="#0F1A20"
      android:gravity="center_vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp">

      <TextView
        android:id="@+id/listenLabel"
        android:text="SMS + alerts on"
        android:textColor="#1EC9A0"
        android:textSize="12sp"
        android:maxLines="2"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp" />

      <Button
        android:id="@+id/smsPermBtn"
        android:text="Allow SMS"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="#FF8A80"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

      <Button
        android:id="@+id/logoutBtn"
        android:text="Logout"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="#F0D28A"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    </LinearLayout>

    <WebView
      android:id="@+id/adminWeb"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />
  </LinearLayout>

  <!-- Login overlay -->
  <ScrollView
    android:id="@+id/loginPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A1419"
    android:visibility="gone">

    <LinearLayout
      android:orientation="vertical"
      android:padding="20dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <TextView
        android:text="DesiChat Admin"
        android:textColor="#EEF3F5"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <TextView
        android:text="Full admin on phone · SMS unlock · live alerts"
        android:textColor="#8AA0AB"
        android:textSize="13sp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Site URL">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/baseUrl"
          android:inputType="textUri"
          android:text="https://rpdesichat.online"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Admin ID"
        android:layout_marginTop="8dp">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/adminId"
          android:inputType="text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Admin password"
        android:layout_marginTop="8dp">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/adminPass"
          android:inputType="textPassword"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
      </com.google.android.material.textfield.TextInputLayout>

      <Button
        android:id="@+id/loginBtn"
        android:text="Open full admin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

      <TextView
        android:text="After login, Android will ask for SMS + Notifications. If you denied once: phone Settings → Apps → DesiChat Admin → Permissions → SMS → Allow."
        android:textColor="#8AA0AB"
        android:textSize="12sp"
        android:paddingTop="10dp"
        android:lineSpacingExtra="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <TextView
        android:id="@+id/status"
        android:textColor="#C5D5DC"
        android:textSize="13sp"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    </LinearLayout>
  </ScrollView>
</FrameLayout>
